# Temporal persistence only. ChoreoOS node state lives in each node's own
# C++ data directory and is never stored in this database.
POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal
POSTGRES_PORT=5432

# Temporal orchestration layer
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=choreoos
TEMPORAL_UI_PORT=8080

# Pinned local infrastructure versions
POSTGRESQL_VERSION=16
TEMPORAL_VERSION=1.31.0
TEMPORAL_ADMINTOOLS_VERSION=1.31.0
TEMPORAL_UI_VERSION=2.49.1
